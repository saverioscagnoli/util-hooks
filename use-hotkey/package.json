{
  "name": "@util-hooks/use-hotkey",
  "version": "3.0.2",
  "type": "module",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "license": "MIT",
  "author": "Saverio Scagnoli <95577971+saverioscagnoli@users.noreply.github.com>",
  "description": "A React hook to simplify the use of keyboard shortcuts.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saverioscagnoli/util-hooks.git#master"
  },
  "homepage": "https://github.com/saverioscagnoli/util-hooks/tree/master/use-hotkey#readme",
  "keywords": [
    "hotkey",
    "react",
    "hooks",
    "keyboard",
    "shortcut",
    "use-hotkey"
  ],
  "scripts": {
    "lint": "tsc --noEmit",
    "build": "rm -rf dist && tsc && cp dist/index.d.ts dist/index.d.cts && rolldown -c ../rolldown.config.ts",
    "prepublishOnly": "yarn build"
  },
  "dependencies": {
    "@util-hooks/use-event": "*"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@types/react": ">=16.8.0",
    "@types/react-dom": ">=16.8.0"
  }
}
